# =============================================================================
# Smart ADO Hours Auto-Updater — configuration
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ⚠️  NEVER commit .env — it holds your PAT and is in .gitignore
# =============================================================================

# Azure DevOps Personal Access Token
# Create at: https://dev.azure.com/<your-org>/_usersSettings/tokens
# Required scope: Work Items (Read & Write)
ADO_PAT=your_ado_personal_access_token

# Azure DevOps organization (the part after dev.azure.com/)
ADO_ORG=delhivery

# Azure DevOps project / team project
ADO_PROJECT=GM-WMS

# Total whole hours to distribute across active tasks each day
DAILY_BUDGET=6
